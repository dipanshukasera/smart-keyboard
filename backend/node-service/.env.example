PORT=4000
MONGODB_URI=mongodb://localhost:27017/smart_keyboard
JWT_SECRET=change-me-in-production

# GIF search: pick which provider /api/gif/search proxies to.
# GIF_PROVIDER = tenor | giphy | rapidapi
GIF_PROVIDER=tenor
TENOR_API_KEY=
GIPHY_API_KEY=
RAPIDAPI_KEY=
# Only used when GIF_PROVIDER=rapidapi. Defaults to RapidAPI's Giphy
# mirror; point at whichever RapidAPI GIF-search listing you subscribed to.
RAPIDAPI_GIF_HOST=giphy.p.rapidapi.com

GOOGLE_TRANSLATE_API_KEY=
