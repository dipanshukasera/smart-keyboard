PORT=4000
MONGODB_URI=mongodb://localhost:27017/smart_keyboard
JWT_SECRET=change-me-in-production

# GIF search: every provider below with its key set gets queried in
# parallel (see gifProviders.js) - GIF_PROVIDER narrows that down to a
# comma-separated subset (e.g. GIF_PROVIDER=klipy), or leave it as "all"
# to use everything configured.
# GIF_PROVIDER = all | tenor | klipy
GIF_PROVIDER=all
TENOR_API_KEY=
# From klipy.com's Partner Panel - set GIF_PROVIDER=klipy (or leave it as
# "all") once this is filled in.
KLIPY_APP_KEY=

GOOGLE_TRANSLATE_API_KEY=
