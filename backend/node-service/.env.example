PORT=4000
MONGODB_URI=mongodb://localhost:27017/smart_keyboard
JWT_SECRET=change-me-in-production

# GIF search: every provider below with its key set gets queried in
# parallel (see gifProviders.js) - GIF_PROVIDER narrows that down to a
# comma-separated subset (e.g. GIF_PROVIDER=klipy), or leave it as "all"
# to use everything configured.
# GIF_PROVIDER = all | tenor | klipy
GIF_PROVIDER=all
TENOR_API_KEY=
# From klipy.com's Partner Panel - set GIF_PROVIDER=klipy (or leave it as
# "all") once this is filled in.
KLIPY_APP_KEY=

# From your DeepL account's API Keys page (deepl.com/your-account/keys).
# A free-tier key ends in ":fx" - translate.controller.js uses that to
# pick the right API host automatically.
DEEPL_API_KEY=

# Adult GIF search (/api/gif/adult/search). Off unless set to exactly
# "true" - and even then, nothing adult is shown until the user turns
# "Adult GIFs" on themselves in the keyboard's settings panel. Results
# are served from a separate endpoint and are never merged into the
# ordinary GIF grid, so leaving this unset keeps the keyboard's default
# search safe for everyone.
ENABLE_ADULT_GIFS=false
